# Local settings for `make deploy` / `make dmg` (copy to .env, which is not committed).

# Where `make deploy` installs the app (default: /Applications/My Tauri).
# Use /Applications to install directly under it.
# DEPLOY_DIR=/Applications/My Tauri

# Set to true to also build and publish the DMG after `make deploy`.
DEPLOY_DMG=false
# Destination folder for the DMG: the Tauri folder inside the iCloud Drive Build folder,
# which `install-my-apps` reads (Swift apps use Build/Swift).
# DMG_DEST=~/Library/Mobile Documents/com~apple~CloudDocs/Build/Tauri
